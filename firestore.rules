rules_version = '2';

// Firestore security rules for the `skill-lab-web` project.
//
// IMPORTANT: this project is shared. As well as the OSCE exam app, it holds
// collections belonging to another application — users, passwords, groups,
// students, attendance, assessments. Those are left exactly as they were
// found, because tightening rules for an app whose auth model is unknown
// would take it offline. Replacing this file with OSCE-only rules would do
// the same by omission: a collection with no matching allow rule is denied.
//
// ── OSCE app ────────────────────────────────────────────────────────────────
//
// The OSCE collections previously granted `allow read, write: if true`, so
// every student name, candidate number and mark was readable and writable by
// anyone who knew the project id — and the project id ships inside the app's
// JavaScript. They now require a signed-in session.
//
// The app has no user accounts, so each device signs in anonymously. That is a
// bar, not a wall: anyone can obtain an anonymous session too. Enable App Check
// as well so requests must come from your app. Real access control needs real
// accounts.
//
// DEPLOY IN THIS ORDER, or OSCE sync breaks:
//   1. Firebase console → Authentication → Sign-in method → enable Anonymous
//   2. Deploy the app build that signs in anonymously
//   3. Deploy these rules
//
// ── Still to do ─────────────────────────────────────────────────────────────
//
// The collections in the "other application" block below are still open to
// anyone. `passwords` in particular is world-readable AND world-writable.
// They need the same treatment as the OSCE ones, but that has to be done by
// someone who knows how that app authenticates.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // The fields a mark must carry to be worth storing at all.
    function validEvaluation() {
      let d = request.resource.data;
      return d.keys().hasAll(['id', 'examId', 'candidateId', 'stationId', 'examinerName'])
        && d.examId is string && d.examId.size() > 0
        && d.candidateId is string && d.candidateId.size() > 0
        && d.stationId is string && d.stationId.size() > 0
        && d.totalScore is number
        && d.maxPossibleScore is number;
    }

    // A re-sync may stamp the sync fields again. Nothing else about a
    // recorded mark may change after the fact.
    function onlySyncFieldsChanged() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(['synced', 'syncedAt']);
    }

    // ─── OSCE exam app ──────────────────────────────────────────────────────

    // Exam templates — stations, checklists, scoring. Not deletable from a
    // device: losing a template orphans every mark that references it.
    match /exams/{examId} {
      allow read: if signedIn();
      allow create, update: if signedIn();
      allow delete: if false;
    }

    // Candidate roster. Personal data, so reads require a session.
    match /candidates/{candidateId} {
      allow read: if signedIn();
      allow create, update: if signedIn();
      allow delete: if false;
    }

    // Circuit assignments made at check-in.
    match /checkIns/{checkInId} {
      allow read: if signedIn();
      allow create, update: if signedIn();
      allow delete: if signedIn();
    }

    // Exam results. Write-once: a mark can be created and can have its sync
    // status stamped, but the scores themselves cannot be rewritten later and
    // cannot be deleted. A grade appeal should find the same numbers the
    // examiner entered.
    match /evaluations/{evaluationId} {
      allow read: if signedIn();
      allow create: if signedIn() && validEvaluation();
      allow update: if signedIn() && onlySyncFieldsChanged();
      allow delete: if false;
    }

    // ─── Other application — UNCHANGED, still open to anyone ────────────────
    //
    // Left as found so this deploy cannot break that app. Every one of these
    // still allows unauthenticated read and write. See the note at the top.

    match /users/{userId} {
      allow read, write: if true; // POC: Allow all access
    }

    // WARNING: world-readable and world-writable credentials store.
    match /passwords/{username} {
      allow read, write: if true; // POC: Allow all access
    }

    match /groups/{groupId} {
      allow read, write: if true; // Allow all admins to read/write groups
    }

    match /students/{studentId} {
      allow read, write: if true; // Allow all admins to read/write students
    }

    match /attendance/{recordId} {
      allow read, write: if true; // Allow trainers and admins to track attendance
    }

    match /assessments/{recordId} {
      allow read, write: if true; // Allow trainers and admins to record assessments
    }
  }
}
