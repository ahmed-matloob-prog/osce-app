# Test build credentials — deliberately fake.
#
# Vite inlines VITE_* variables into the bundle at build time. Building with
# the real .env produces a dist/ that talks to the live Firebase project, so
# anything driving that build (a browser test, a local demo, a screenshot run)
# writes real documents into production.
#
# Build with `npm run build:test` to use these instead. isFirebaseConfigured()
# rejects the placeholder values, so the app runs fully offline against
# IndexedDB and never reaches the network.
#
# Safe to commit: there are no secrets here.

VITE_FIREBASE_API_KEY=test-api-key-not-real
VITE_FIREBASE_AUTH_DOMAIN=test.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=test-project
VITE_FIREBASE_STORAGE_BUCKET=test.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000
