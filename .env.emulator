# Points the app at a local Firestore emulator instead of any real project.
# Build with `npm run build:emulator`, and run `npm run emulator` alongside.
#
# The project id is deliberately not the live one, and nothing here reaches the
# network beyond localhost.
VITE_FIREBASE_API_KEY=emulator-key
VITE_FIREBASE_AUTH_DOMAIN=emulator.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=osce-emulator
VITE_FIREBASE_STORAGE_BUCKET=emulator.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:emulator
VITE_FIREBASE_EMULATOR=1
